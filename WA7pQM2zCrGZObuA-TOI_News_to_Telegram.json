    {
      "parameters": {
        "jsCode": "let summary = \"\";  // Initialize the summary variable\nconst titles = $input.first().json.titles || [];\nconst links = $input.first().json.links || [];\nconst dates = $input.first().json.dates || [];\n{\nsummary += `<b>Today's Top 10 Headlines</b>\\n\\n`;\n}\nfor (let i = 0; i < Math.min(titles.length, 10); i++) {\n  summary += `${i + 1}. <b>${titles[i]}</b>\\n`;\n  summary += `🔗 <a href=\"${links[i]}\">Read more</a>\\n\\n`;\n}\n\n\nreturn [\n  {\n    json: {\n      formatted_summary: summary\n    }\n  }\n];"
      },
